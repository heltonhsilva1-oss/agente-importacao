# Copie este arquivo para .env e preencha os valores reais
# NUNCA versione o arquivo .env — ele está no .gitignore

# Uazapi — URL base da sua instância e token de autenticação
UAZAPI_SERVER_URL=https://seu-servidor.uazapi.com.br
UAZAPI_INSTANCE_TOKEN=seu_token_uazapi_aqui

# Segredo usado no caminho do webhook:
# https://seu-backend.railway.app/webhook/SEU_SEGREDO
# Gere um valor aleatório longo, por exemplo: openssl rand -hex 32
WEBHOOK_PATH_SECRET=gere_um_segredo_aleatorio_longo

# Assina links diretos do Portal (?tel=...&acesso=...)
# Use outro segredo aleatório, diferente do segredo do webhook.
PORTAL_LINK_SECRET=gere_outro_segredo_aleatorio_longo

# Origens autorizadas a chamar a API do Portal, separadas por vírgula.
PORTAL_ALLOWED_ORIGINS=https://minhaimportacao-5442a.web.app
PORTAL_URL=https://minhaimportacao-5442a.web.app/portal

# Mercado Pago Checkout Transparente (somente no backend)
# Use primeiro o Access Token de teste e depois substitua pelo produtivo.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu_access_token
# Gerado ao salvar o webhook do evento Order (Mercado Pago).
MERCADOPAGO_WEBHOOK_SECRET=seu_segredo_de_assinatura_webhook
MERCADOPAGO_WEBHOOK_PATH_SECRET=gere_um_segredo_aleatorio_com_64_caracteres

# Claude API
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Números WhatsApp (formato internacional sem +)
AGENT_PHONE=5511961482602
OPERATOR_PHONE=5511995715042
